# ── Supabase ──────────────────────────────────────────────────────────────
# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by scripts/seed-supabase.ts and any privileged server
# code. Never expose this to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Map provider (MapLibre GL JS) ────────────────────────────────────────
# No environment variable needed. The map renders on a free, keyless CARTO
# Positron basemap (built on OpenStreetMap data) via MapLibre GL JS — no
# signup or token required. See lib/maps/mapConfig.ts to swap in a
# Mapbox/MapTiler vector style later if you want one.

# ── Google Places (place enrichment / lookup) ────────────────────────────
# Server-only. Without this, services/google falls back to a seed-backed
# mock provider.
GOOGLE_PLACES_API_KEY=

# ── Google OAuth (via Supabase Auth) ─────────────────────────────────────
# Configured in the Supabase dashboard (Authentication → Providers →
# Google), not as env vars here. See README for setup steps.

# ── Social listening (TikTok / future integrations) ──────────────────────
# No compliant real-time provider is wired up yet — services/social always
# uses the seeded mock provider. Reserved for a future adapter:
# SOCIAL_LISTENING_API_KEY=

# ── Analytics (future) ────────────────────────────────────────────────────
# lib/analytics logs to the console by default. Point it at a real
# analytics provider by wiring window.__analyticsSink or swapping
# lib/analytics/track.ts.
# NEXT_PUBLIC_ANALYTICS_KEY=
